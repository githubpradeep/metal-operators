from typing import List, Tuple

class MetalKMeans:
    def __init__(self, n_clusters: int, max_iterations: int = 100, tolerance: float = 1e-4, seed: int = 42) -> None: ...
    def fit(self, data: List[float], n: int, d: int) -> None: ...
    def predict(self, data: List[float], n: int, d: int) -> List[int]: ...
    def fit_bytes(self, data: bytes, n: int, d: int) -> None: ...
    def predict_bytes(self, data: bytes, n: int, d: int) -> List[int]: ...
    @property
    def centroids(self) -> List[float]: ...
    @property
    def labels(self) -> List[int]: ...
    @property
    def inertia(self) -> float: ...
    @property
    def n_iter(self) -> int: ...

def metal_kmeans_fit(
    data: List[float],
    n: int,
    d: int,
    n_clusters: int,
    max_iterations: int = 100,
    tolerance: float = 1e-4,
    seed: int = 42,
) -> Tuple[List[int], List[float], int, float]: ...

def metal_kmeans_fit_bytes(
    data: bytes,
    n: int,
    d: int,
    n_clusters: int,
    max_iterations: int = 100,
    tolerance: float = 1e-4,
    seed: int = 42,
) -> Tuple[List[int], List[float], int, float]: ...

class MetalKNeighbors:
    def __init__(self, n_neighbors: int = 5) -> None: ...
    def fit(self, data: List[float], n: int, d: int) -> None: ...
    def kneighbors(self, queries: List[float], nq: int) -> Tuple[List[float], List[int]]: ...
    def fit_bytes(self, data: bytes, n: int, d: int) -> None: ...
    def kneighbors_bytes(self, queries: bytes, nq: int) -> Tuple[List[float], List[int]]: ...

def metal_kneighbors(
    corpus: List[float],
    n_corpus: int,
    d: int,
    queries: List[float],
    n_queries: int,
    n_neighbors: int = 5,
) -> Tuple[List[float], List[int]]: ...

def metal_kneighbors_bytes(
    corpus: bytes,
    n_corpus: int,
    d: int,
    queries: bytes,
    n_queries: int,
    n_neighbors: int = 5,
) -> Tuple[List[float], List[int]]: ...

class MetalPCA:
    def __init__(self, n_components: int) -> None: ...
    def fit(self, data: List[float], n: int, d: int) -> None: ...
    def transform(self, data: List[float], n: int, d: int) -> List[float]: ...
    def fit_transform(self, data: List[float], n: int, d: int) -> List[float]: ...
    def fit_bytes(self, data: bytes, n: int, d: int) -> None: ...
    def transform_bytes(self, data: bytes, n: int, d: int) -> List[float]: ...
    def fit_transform_bytes(self, data: bytes, n: int, d: int) -> List[float]: ...
    @property
    def components(self) -> List[float]: ...
    @property
    def explained_variance(self) -> List[float]: ...
    @property
    def explained_variance_ratio(self) -> List[float]: ...
    @property
    def singular_values(self) -> List[float]: ...
    @property
    def mean(self) -> List[float]: ...
    @property
    def noise_variance(self) -> float: ...

def metal_pca_fit(
    data: List[float],
    n: int,
    d: int,
    n_components: int,
) -> Tuple[List[float], List[float], List[float]]: ...

def metal_pca_fit_bytes(
    data: bytes,
    n: int,
    d: int,
    n_components: int,
) -> Tuple[List[float], List[float], List[float]]: ...

class MetalLogisticRegression:
    def __init__(
        self,
        c: float = 1.0,
        learning_rate: float = 0.01,
        momentum: float = 0.9,
        max_epochs: int = 100,
        batch_size: int = 256,
        tol: float = 1e-4,
        seed: int = 42,
    ) -> None: ...
    def fit(self, data: List[float], y: List[float], n: int, d: int) -> None: ...
    def predict(self, data: List[float], n: int, d: int) -> List[float]: ...
    def predict_proba(self, data: List[float], n: int, d: int) -> List[float]: ...
    def score(self, data: List[float], y: List[float], n: int, d: int) -> float: ...
    def fit_bytes(self, data: bytes, y: bytes, n: int, d: int) -> None: ...
    def predict_bytes(self, data: bytes, n: int, d: int) -> List[float]: ...
    def predict_proba_bytes(self, data: bytes, n: int, d: int) -> List[float]: ...
    def score_bytes(self, data: bytes, y: bytes, n: int, d: int) -> float: ...
    @property
    def weights(self) -> List[float]: ...
    @property
    def bias(self) -> float: ...
    @property
    def coef_(self) -> List[float]: ...
    @property
    def intercept_(self) -> float: ...
    @property
    def n_epochs(self) -> int: ...
    @property
    def final_loss(self) -> float: ...

def metal_logistic_regression_fit(
    data: List[float],
    y: List[float],
    n: int,
    d: int,
    c: float = 1.0,
    learning_rate: float = 0.01,
    momentum: float = 0.9,
    max_epochs: int = 100,
    batch_size: int = 256,
    tol: float = 1e-4,
    seed: int = 42,
) -> Tuple[List[float], float, int, float]: ...

def metal_logistic_regression_fit_bytes(
    data: bytes,
    y: bytes,
    n: int,
    d: int,
    c: float = 1.0,
    learning_rate: float = 0.01,
    momentum: float = 0.9,
    max_epochs: int = 100,
    batch_size: int = 256,
    tol: float = 1e-4,
    seed: int = 42,
) -> Tuple[List[float], float, int, float]: ...
